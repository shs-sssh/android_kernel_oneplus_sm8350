From: OpenAI
Subject: [PATCH] SELinux: route selinuxfs queries through SukiSU hide state on 5.4

Expose a guarded state selector and use the pre-KernelSU state for SELinuxFS
query endpoints for app UIDs. The inline fallback avoids unresolved references
when CONFIG_KSU is disabled.

diff --git a/security/selinux/selinuxfs.c b/security/selinux/selinuxfs.c
--- a/security/selinux/selinuxfs.c
+++ b/security/selinux/selinuxfs.c
@@ -13,6 +13,7 @@
  */
 
 #include <linux/kernel.h>
+#include <linux/ksu_selinux_hide.h>
 #include <linux/pagemap.h>
 #include <linux/slab.h>
 #include <linux/vmalloc.h>
@@ -126,7 +127,7 @@
 	ssize_t length;
 
 	length = scnprintf(tmpbuf, TMPBUFLEN, "%d",
-			   enforcing_enabled(fsi->state));
+			   enforcing_enabled(ksu_selinux_hide_select_state(fsi->state)));
 	return simple_read_from_buffer(buf, count, ppos, tmpbuf, length);
 }
 
@@ -136,7 +137,7 @@
 
 {
 	struct selinux_fs_info *fsi = file_inode(file)->i_sb->s_fs_info;
-	struct selinux_state *state = fsi->state;
+	struct selinux_state *state = ksu_selinux_hide_select_state(fsi->state);
 	char *page = NULL;
 	ssize_t length;
 	int old_value, new_value;
@@ -199,7 +200,7 @@
 					size_t count, loff_t *ppos)
 {
 	struct selinux_fs_info *fsi = file_inode(filp)->i_sb->s_fs_info;
-	struct selinux_state *state = fsi->state;
+	struct selinux_state *state = ksu_selinux_hide_select_state(fsi->state);
 	char tmpbuf[TMPBUFLEN];
 	ssize_t length;
 	ino_t ino = file_inode(filp)->i_ino;
@@ -219,7 +220,7 @@
 static int sel_open_handle_status(struct inode *inode, struct file *filp)
 {
 	struct selinux_fs_info *fsi = file_inode(filp)->i_sb->s_fs_info;
-	struct page    *status = selinux_kernel_status_page(fsi->state);
+	struct page    *status = selinux_kernel_status_page(ksu_selinux_hide_select_state(fsi->state));
 
 	if (!status)
 		return -ENOMEM;
@@ -304,7 +305,7 @@
 		goto out;
 
 	if (new_value) {
-		enforcing = enforcing_enabled(fsi->state);
+		enforcing = enforcing_enabled(ksu_selinux_hide_select_state(fsi->state));
 		length = selinux_disable(fsi->state);
 		if (length)
 			goto out;
@@ -362,7 +363,7 @@
 	ssize_t length;
 
 	length = scnprintf(tmpbuf, TMPBUFLEN, "%d",
-			   security_mls_enabled(fsi->state));
+			   security_mls_enabled(ksu_selinux_hide_select_state(fsi->state)));
 	return simple_read_from_buffer(buf, count, ppos, tmpbuf, length);
 }
 
