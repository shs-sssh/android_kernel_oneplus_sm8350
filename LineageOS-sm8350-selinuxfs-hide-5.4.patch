diff --git a/include/linux/ksu_selinux_hide.h b/include/linux/ksu_selinux_hide.h
new file mode 100644
--- /dev/null
+++ b/include/linux/ksu_selinux_hide.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_KSU_SELINUX_HIDE_H
+#define _LINUX_KSU_SELINUX_HIDE_H
+
+#include <linux/kconfig.h>
+#include <linux/version.h>
+
+struct selinux_state;
+
+#if IS_ENABLED(CONFIG_KSU) && LINUX_VERSION_CODE < KERNEL_VERSION(5, 10, 0)
+struct selinux_state *ksu_selinux_hide_select_state(struct selinux_state *state);
+#else
+static inline struct selinux_state *
+ksu_selinux_hide_select_state(struct selinux_state *state)
+{
+    return state;
+}
+#endif
+
+#endif /* _LINUX_KSU_SELINUX_HIDE_H */
