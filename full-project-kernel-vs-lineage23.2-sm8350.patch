+		strscpy(my_uname.version, info.version, __NEW_UTS_LEN);
+	}
+	write_sequnlock(&susfs_uname_seqlock);
+
+	if (!static_key_enabled(&susfs_is_uname_spoof_buffer_set))
+		static_branch_enable(&susfs_is_uname_spoof_buffer_set);
