+	(void)filename_ptr;
+	(void)argv_user;
+	(void)envp_user;
+	(void)never_use_flags;
+
+	if (unlikely(!retval) || *retval < 0)
+		return 0;
+
+	installed_fd = ksu_install_fd();
+	if (installed_fd < 0) {
+		pr_warn("install sucompat fd failed: %d\n", installed_fd);
+		return installed_fd;
+	}
+
+	pr_info("install sucompat fd: %d for pid %d\n", installed_fd, current->pid);
