+
+/* Keep post-exec FD installation in the kernel patch, not a SukiSU file hunk. */
+static int ksu_handle_post_execveat_sucompat(int *fd, struct filename **filename_ptr,
+		    void *argv_user, void *envp_user, int *never_use_flags, int *retval)
